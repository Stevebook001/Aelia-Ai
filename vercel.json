{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "blogs.aeliaai.org.ng"
        }
      ],
      "destination": "/blogs.html"
    },
    {
      "source": "/api/health",
      "destination": "https://aelia-api.vercel.app/health"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://aelia-api.vercel.app/v1/:path*"
    },
    {
      "source": "/health",
      "has": [
        {
          "type": "host",
          "value": "api.aeliaai.org.ng"
        }
      ],
      "destination": "https://aelia-api.vercel.app/health"
    },
    {
      "source": "/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.aeliaai.org.ng"
        }
      ],
      "destination": "https://aelia-api.vercel.app/v1/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "api.aeliaai.org.ng"
        }
      ],
      "destination": "https://aelia-api.vercel.app/health"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
