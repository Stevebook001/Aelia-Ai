# AELIA API — server-side secrets only
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# AI provider abstraction
# For OpenAI, set OPENAI_API_KEY or use the provider-neutral AI_API_KEY.
AI_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5.6-luna

# Production data layer — add when persistence is enabled
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Email — all official AELIA mail should use @aeliaai.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@aeliaai.org

# Billing (add only after provider is selected)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=


# AELIA production architecture
# Keep secrets server-side only. Never commit real values.
AELIA_API_KEY=
SESSION_SECRET=
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Email / verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@aeliaai.org

# Payments
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional web/search providers
WEB_SEARCH_API_KEY=

# Optional observability
SENTRY_DSN=

# Messaging gateway (services/messaging)
AELIA_API_BASE=https://api.aeliaai.org
PUBLIC_BASE_URL=https://msg.aeliaai.org
PORT=3100

# WhatsApp linked-device adapter (Baileys)
WHATSAPP_PHONE_NUMBER=2348104468690
WHATSAPP_AUTH_DIR=/data/whatsapp-auth

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
